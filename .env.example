# YouTube API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube Playlist IDs
# Replace with your actual playlist IDs
VITE_YOUTUBE_MAIN_PLAYLIST_ID=PLrAXtmRdnEQy8Q8Q8Q8Q8Q8Q8Q8Q8Q8Q
VITE_YOUTUBE_TIPS_PLAYLIST_ID=PLrAXtmRdnEQy9Q9Q9Q9Q9Q9Q9Q9Q9Q9Q
VITE_YOUTUBE_FEATURED_PLAYLIST_ID=PLrAXtmRdnEQy7Q7Q7Q7Q7Q7Q7Q7Q7Q

# Analytics Configuration (optional)
VITE_ENABLE_VIDEO_ANALYTICS=true
VITE_ANALYTICS_ENDPOINT=https://your-analytics-endpoint.com/api/events

# Performance Settings
VITE_YOUTUBE_CACHE_DURATION=300000
VITE_YOUTUBE_MAX_RESULTS_DEFAULT=6

# App Store Links
VITE_IOS_APP_URL=https://apps.apple.com/us/app/tuggi-drive/id6744379818?l=pt-BR

# Supabase Configuration
# Frontend (for CTA component)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend (for API endpoints)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here